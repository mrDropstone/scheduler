import { Subject, Constraints } from "pages/constraints.slint";
import { Timetable } from "pages/timetable.slint";
import { CustomButton } from "components/index.slint";
import { Theme } from "theme.slint";
import { Style } from "style.slint";
import { VerticalBox, Button } from "std-widgets.slint";
import { AppAction, AppActions } from "globals.slint";
export { AppAction, AppActions } from "globals.slint";



export component MainWindow inherits Window {
    title: "Scheduler";
    preferred-height: 800px;
    preferred-width: 800px;
    min-height: 400px;
    min-width: 600px;
    background: Theme.current.background;

    in-out property <int> page: 0;

    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: Theme.current.surface;

            Rectangle {
                x: parent.width - self.width;
                height: parent.height;
                width: Style.current.border;
                background: Theme.current.border;
            }
            VerticalBox {
                CustomButton {
                    width: 180px;
                    text: "Constraints";
                    bg-color: #171922;
                    text-color: #6b7280;
                    clicked => {
                        AppActions.trigger(AppAction.Constraints);
                    }
                }
                CustomButton {
                    width: 180px;
                    text: "Timetable";
                    bg-color: #171922;
                    text-color: #6b7280;
                    clicked => {
                        AppActions.trigger(AppAction.Timetable);
                    }
                }
            }
        }

        Rectangle {
            Constraints {
                visible: page == 0;
            }
            Timetable {
                visible: page == 1;
            }
        }
    } 
}
