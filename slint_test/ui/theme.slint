export struct ThemeTokens {
    background: color,
    surface: color,
    text: color,
    border: color,
    border-width: length,
    radius: length,
    spacing-sm: length,
    padding-top: length,
}

export global Theme {
    out property <ThemeTokens> dark: {
        background: #0e1015,
        surface: #171922,
        border: #272a35,
        border-width: 1px,
        text: white,
        radius : 10px,
        spacing-sm : 20px,
        padding-top: 15px,
    };

    in-out property <ThemeTokens> current: dark;
}

