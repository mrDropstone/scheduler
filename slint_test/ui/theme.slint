export struct ThemeTokens {
    background: color,
    surface: color,
    text: color,
    border: color,
    muted: color,
    accent: color,
    accent-hover: color,
    accent-soft: color,
    green: color,
    red: color,
}

export global Theme {
    out property <ThemeTokens> dark: {
        background: #0e1015,
        surface: #171922,
        text: #14161a,
        border: #272a35,
        muted: #6b7280,
        accent: #171922,
        accent-hover: #232842,
        accent-soft: #eef0ff,
        green: #0f9d58,
        red: #dc2626,
    };

    in-out property <ThemeTokens> current: dark;
}

