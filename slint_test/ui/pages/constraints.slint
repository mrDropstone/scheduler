import { Subject, Teacher } from "../types.slint";
import { AppActions, AppAction } from "../globals.slint";
import { VerticalBox, ListView, Button, ComboBox } from "std-widgets.slint";
import { HorizontalBorder, VerticalBorder, CustomEdit, Card, CardWithName, Title, CustomButton } from "../components/index.slint";
import { Theme } from "../theme.slint";
import { Style } from "../style.slint";
import { AppData } from "../state.slint";


export component SubjectConfig inherits Rectangle {
    in-out property <string> name;
    in-out property <string> difficulty;

    HorizontalLayout {
        spacing: 20px;

        CustomEdit {
            input <=> root.name;
            width: 300px;
        }
        CustomEdit {
            input <=> root.difficulty;
            input-type: number;
            width: 100px;
        }
    }
}

export component Constraints inherits VerticalBox {
    height: 100%;
    width: 100%;
    padding-right: 0px;

    Title {
        title-text: "Constraints";
    }
    Flickable {
        height: 100%;
        width: 100%;
        content-height: 2000px;

        VerticalBox {
            width: 100%;
            spacing: Style.current.spacing-sm; 
            padding-top: Style.current.padding-top;

            CardWithName {
                name: "Subjects";
                description: "subject names and difficulties";
                width: (parent.width - 40px);
                x: (parent.width - self.width) / 2;

                HorizontalBorder {
                    x: 0px;
                    width: parent.width;
                }
                VerticalLayout {
                    x: 20px;
                    spacing: Style.current.spacing-sm;
                    padding-top: 20px;

                    for subject in AppData.subjects: Text {
                        SubjectConfig {
                            name <=> subject.name;
                            difficulty <=> subject.difficulty;
                            x: 0px;
                        }
                    }
                    CustomButton {
                        x: 0px;
                        width: 150px;
                        text: "add subject";
                        clicked => {
                            AppActions.trigger(AppAction.AddSubject);
                        }
                    }
                }
            }
            CardWithName {
                name: "Teachers";
                description: "teacher names and availability";
                width: (parent.width - 40px);
                x: (parent.width - self.width) / 2;

                HorizontalBorder {
                    x: 0px;
                    width: parent.width;
                }
                VerticalLayout {
                    x: 20px;
                    spacing: Style.current.spacing-sm;
                    padding-top: 20px;
                    
                    FlexboxLayout {
                        spacing: 8px;
                        cross-axis-line-alignment: start;

                        for teacher in AppData.teachers : Card {
                            width: 200px;
                            Text {
                                text: teacher.name;
                                color: Theme.current.text;
                            }
                        }
                    }

                    CustomButton {
                        x: 0px;
                        width: 150px;
                        text: "add teacher";
                        clicked => {
                            AppActions.trigger(AppAction.AddTeacher);
                        }
                    }
                }
            }
            CardWithName {
                name: "Classes";
                description: "class names, course, daily limits";
                width: (parent.width - 40px);
                x: (parent.width - self.width) / 2;
            }
        }
    }
}
