import { VerticalBox, ListView, Button } from "std-widgets.slint";
import { HorizontalBorder, VerticalBorder, Input, Card, CardWithName, Title, CustomButton } from "../components/index.slint";
import { Theme } from "../theme.slint";
import { Style } from "../style.slint";


export component SubjectConfig inherits Rectangle {
    in-out property <string> name;
    in-out property <string> difficulty;

    HorizontalLayout {
        spacing: 20px;

        name := Input {
            width: 300px;
        }
        difficulty := Input {
            input-type: number;
            width: 100px;
        }
    }
}

export struct Subject {
    name: string,
    difficulty: string,
}

export component Constraints inherits VerticalBox {
    in-out property <[Subject]> subjects: [
        { name: "math", difficulty: "12" },
        //{ name: "chemistry", difficulty: 5 },
    ];

    VerticalBox {
        height: 100%;
        width: 100%;
        padding-right: 0px;

        Title {
            title-text: "Constraints";
        }
        Flickable {
            height: 100%;
            width: 100%;
            content-height: 2000px;

            VerticalBox {
                width: 100%;
                spacing: Style.current.spacing-sm; 
                padding-top: Style.current.padding-top;

                CardWithName {
                    name: "Subjects";
                    description: "subject names and difficulties";
                    width: (parent.width - 40px);
                    x: (parent.width - self.width) / 2;

                    HorizontalBorder {
                        x: 0px;
                        width: parent.width;
                    }
                    layout := VerticalLayout {
                        x: 20px;
                        spacing: Style.current.spacing-sm;
                        padding-top: 20px;

                        for subject in root.subjects: Text {
                            SubjectConfig {
                                x: 0px;
                            }
                        }
                        CustomButton {
                            x: 0px;
                            width: 150px;
                            text: "add subject";
                        }
                    }
                }
                CardWithName {
                    name: "Teachers";
                    description: "teacher names and availability";
                    width: (parent.width - 40px);
                    x: (parent.width - self.width) / 2;
                }
                CardWithName {
                    name: "Classes";
                    description: "class names, course, daily limits";
                    width: (parent.width - 40px);
                    x: (parent.width - self.width) / 2;
                }
            }
        }
    }
}
