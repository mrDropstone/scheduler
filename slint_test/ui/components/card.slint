import { Theme } from "../theme.slint";
import { Style } from "../style.slint";
import { VerticalBox } from "std-widgets.slint";

export component Card inherits Rectangle {
    background: Theme.current.surface;

    border-radius: Style.current.radius;
    border-width: Style.current.border;
    border-color: Theme.current.border;
    height: content.preferred-height;

    content := VerticalLayout {
        padding: Style.current.padding-top;
        spacing: Style.current.spacing-sm;
        alignment: start;
        @children
    }
}

export component CardWithName inherits Card {
    in property <string> name;
    in property <string> description;

    VerticalBox {
        padding: Style.current.padding-top;
        spacing: 8px;
        padding-right: 20px;
        Text {
            text: name;
            font-size: Style.current.text;
            font-weight: FontWeight.bold;
            color: white;
        }
        Text {
            text: description;
            font-size: Style.current.muted;
            color: #9BA2B0;
        }
    }
}
