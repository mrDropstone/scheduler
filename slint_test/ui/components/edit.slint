import { Theme } from "../theme.slint";
import { Style } from "../style.slint";
import { VerticalBox } from "std-widgets.slint";

export component CustomEdit inherits Rectangle {
    height: 30px;
    background: Theme.current.surface;
    border-radius: 5px;
    border-width: Style.current.border;
    border-color: Theme.current.border;
    in property <InputType> input-type: text;
    in-out property <string> input;
    
    TextInput {
        text <=> input;
        input-type: root.input-type;
        x: 10px;
        y: (parent.height - 0.7 * self.height) / 2;
        font-size: 0.5 * parent.height;
        color: white;
    }
}
