import { Theme } from "../theme.slint";
import { Style } from "../style.slint";

export component VerticalBorder inherits Rectangle {
    height: 100%;
    width: Style.current.border;
    background: Theme.current.border;
}

export component HorizontalBorder inherits Rectangle {
    height: Style.current.border;
    width: 100%;
    background: Theme.current.border;
}
